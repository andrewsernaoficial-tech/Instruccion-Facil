{
  "name": "instruccion-facil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "concurrently -k -n api,web \"npm run api\" \"npm run web\"",
    "web": "ng serve --host 0.0.0.0 --port 4200 --proxy-config apps/web/proxy.json",
    "api": "node --env-file-if-exists=.env apps/api/src/server.mjs",
    "build": "ng build",
    "test": "node --test apps/api/test/*.test.mjs",
    "check": "npm test && npm run build",
    "admin:create": "node --env-file-if-exists=.env apps/api/src/create-admin.mjs",
    "format": "prettier --write apps package.json angular.json tsconfig.json README.md docs/*.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  }
}
